# Penang Smart Parking System
# ============================================================
# Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# Application
APP_NAME="Penang Smart Parking"
APP_ENV=production
APP_DEBUG=0
APP_URL=http://localhost/Penang_Smart_Parking
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_KEY=change-this-to-a-random-32-char-string

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=penang_parking
DB_USERNAME=root
DB_PASSWORD=

# Gemini AI (Vehicle Plate Recognition)
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={key}
GEMINI_TIMEOUT=30
GEMINI_CONFIDENCE_THRESHOLD=0.75

# PayPal (Wallet Reload)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# File Storage
EVIDENCE_PATH=/storage/evidence
UPLOAD_MAX_SIZE=10485760

# Session
SESSION_LIFETIME=120
SESSION_SECURE=1
SESSION_HTTP_ONLY=1
